using System;
using System.Collections.Generic;
using LPR381Solver.Models;
using System.Globalization; 
 
 
namespace LPR381Solver.Algorithms
{
	public static class BranchAndBoundSimplexDemo
	{
		public static void RunAll()
		{
			RunKnapsackCrossCheck();
			RunTestInteger();
			RunInfeasible();
		}

		public static void RunKnapsackCrossCheck()
		{
			Console.WriteLine("### CASE 1: Knapsack Cross Check");
			Console.WriteLine("--------------------------------------------------");
			Console.WriteLine();
 
			LPModel model = new LPModel();
			model.ObjectiveType = "max";
			double[] values = { 2, 3, 3, 5, 2, 4 };
			double[] weights = { 11, 8, 6, 14, 10, 10 };
			for (int i = 0; i < values.Length; i++)
				model.Variables.Add(new Variable("x" + (i + 1), values[i], "bin"));
 
			model.Constraints.Add(new Constraint(new List<double>(weights), "<=", 40));
 
			Run(model);
		}
 
		public static void RunTestInteger()
		{
			Console.WriteLine("### CASE 2: Pure IP");
			Console.WriteLine("--------------------------------------------------");
			Console.WriteLine();
 
			LPModel model = new LPModel();
			model.ObjectiveType = "max";
			model.Variables.Add(new Variable("x1", 5, "int"));
			model.Variables.Add(new Variable("x2", 4, "int"));
 
			model.Constraints.Add(new Constraint(new List<double> { 6, 4 }, "<=", 24));
			model.Constraints.Add(new Constraint(new List<double> { 1, 2 }, "<=", 6));
 
			Run(model);
		}
 
		public static void RunInfeasible()
		{
			Console.WriteLine("### CASE 3: Infeasible problem (can't branch))");
			Console.WriteLine("--------------------------------------------------");
			Console.WriteLine();
 
			LPModel model = new LPModel();
			model.ObjectiveType = "max";
			model.Variables.Add(new Variable("x1", 1, "int"));
			model.Variables.Add(new Variable("x2", 1, "int"));
 
			model.Constraints.Add(new Constraint(new List<double> { 1, 1 }, "<=", 2));
			model.Constraints.Add(new Constraint(new List<double> { 1, 1 }, ">=", 10));
 
			Run(model);
		}
 
		private static void Run(LPModel model)
		{
			try
			{
				BranchAndBoundSimplex solver = new BranchAndBoundSimplex();
				solver.Solve(model);
				Console.WriteLine(solver.Log);
				Console.WriteLine("Status : " + solver.Status);
				Console.WriteLine();
			}
			catch (InvalidOperationException ex)
			{
				Console.WriteLine("This model is not solveable");
				Console.WriteLine("Why: " + ex.Message);
				Console.WriteLine();
			}
		}
	}
}