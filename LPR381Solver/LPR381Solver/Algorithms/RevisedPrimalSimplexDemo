        //Run unbounded example
        public static void RunUnbounded()
        {
            Console.WriteLine("### CASE 3 : Unbounded model");
            Console.WriteLine();

            LPModel model = new LPModel();
            model.ObjectiveType = "max";
            model.Variables.Add(new Variable("x1", 1, "+"));
            model.Variables.Add(new Variable("x2", 1, "+"));

            model.Constraints.Add(new Constraint(new List<double> { 1, -1 }, "<=",1));

            Run(model);
        }

        //exercise with Big-M with real artificial pivoting
        public static void RunOptimalGreaterThanMin()
        {
            Console.WriteLine("### CASE 4 : Optimal, >= constraints, minimisation");
            Console.WriteLine();

            LPModel model = new LPModel();
            model.ObjectiveType = "min";
            model.Variables.Add(new Variable("x1", 1, "+"));
            model.Variables.Add(new Variable("x2", 1, "+"));

            model.Constraints.Add(new Constraint(new List<double> { 1, 2 }, ">=", 4));
            model.Constraints.Add(new Constraint(new List<double> { 3, 2 }, ">=", 6));

            Run(model);
        }

        private static void Run(LPModel model)
        {
            try{
                    RevisedPrimalSimplex solver = new RevisedPrimalSimplex();
                    solver.Solve(model);
                    Console.WriteLine(solver.Log);
                    Console.WriteLine("Status: " + solver.Status);
                    Console.WriteLine();
            }
            catch(InvalidOperationException ex)
            {
                Console.WriteLine("This model was not able to be solved");
                Console.WriteLine("Reason: " + ex.Message);
                Console.WriteLine();
            }
        }
    }
}