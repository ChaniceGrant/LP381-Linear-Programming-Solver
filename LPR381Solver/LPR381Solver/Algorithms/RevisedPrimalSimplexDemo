    public static class RevisedPrimalSimplexDemo
    {
        public static void RunAll()
        {
            RunOptimalLessThan();
            RunInfeasible();
            RunUnbounded();
            RunOptimalGreaterThanMin();
        }

        //EXAMPLE
        //Expected: x1 = 2, x2 = 6, z = 36
        public static void RunOptimalLessThan()
        {
            Console.WriteLine("### CASE 1: Optimal, <= constraints only");
			Console.WriteLine();

            LPModel model = new LPModel();
            model.ObjectiveType = "max";
            model.Variables.Add(new Variable("x1", 3, "+"));
            model.Variables.Add(new Variable("x2", 5, "+"));

            model.Constraints.Add(new Constraint(new List<double> { 1, 0 }, "<=", 4));
            model.Constraints.Add(new Constraint(new List<double> { 0, 2 }, "<=", 12));
            model.Constraints.Add(new Constraint(new List<double> { 3, 2 }, "<=", 18));

            Run(model);
        }

        //Run contradictory constraints
        //Expected status = Infeasible
        public static void RunInfeasible()
        {
            Console.WriteLine("### CASE 2 : Infeasible Model");
            Console.WriteLine();

            LPModel model = new LPModel();
